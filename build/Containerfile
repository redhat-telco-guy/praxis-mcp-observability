# Self-contained Containerfile that clones praxis-proxy/ai,
# applies MCP metrics patches, and builds the binary.
# No local Rust/cargo needed — everything happens inside the build.

# ── Stage 1: Build ──
FROM rust:1.85-alpine3.21 AS builder

RUN apk add --no-cache musl-dev openssl-dev openssl-libs-static pkgconfig git python3 make perl cmake g++ linux-headers

WORKDIR /build

# Clone the repo
RUN git clone --depth 1 https://github.com/praxis-proxy/ai.git .

# ── Write metrics.rs ──
COPY metrics.rs filters/src/agentic/mcp/metrics.rs

# ── Patch mod.rs ──
COPY patch-mod-rs.py /tmp/patch-mod-rs.py
RUN python3 /tmp/patch-mod-rs.py

# Build with full features
ENV PRAXIS_AI_FEATURES=full
RUN cargo build --release --features "${PRAXIS_AI_FEATURES}" -p praxis-ai-proxy 2>&1 || \
    (echo "=== Build failed. Trying cargo check for diagnostics ===" && \
     cargo check -p praxis-ai-filters 2>&1 && exit 1)

# ── Stage 2: Runtime ──
FROM alpine:3.21

RUN apk add --no-cache libgcc openssl ca-certificates && \
    adduser -D -u 1001 praxis

COPY --from=builder /build/target/release/praxis-ai /usr/local/bin/praxis-ai

USER 1001
EXPOSE 8080 9901 9902

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1:9901/healthy || exit 1

ENTRYPOINT ["praxis-ai"]
